---
layout: layouts/example.njk
title: Header (example)
---



{%- from "moj/components/header/macro.njk" import mojHeader -%}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% if params.environmentName !== 'PRODUCTION' %}
  {% set environmentTagHtml %}
    {{ govukTag({
      text: params.environmentName | default("DEV"),
      classes: params.environmentNameColour | default(""),
      attributes: {
        'data-qa': 'probation-common-environment-tag'
      }
    }) }}
  {% endset %}
{% endif %}

{% macro searchSvg(width = 32, height = 32) %}
  <svg class="probation-common-header__search-toggle-button-icon" width="{{ width }}" height="{{ height }}" viewBox="0 0 27 27" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <circle cx="12.0161" cy="11.0161" r="8.51613" stroke="currentColor" stroke-width="3"></circle>
    <line x1="17.8668" y1="17.3587" x2="26.4475" y2="25.9393" stroke="currentColor" stroke-width="3"></line>
  </svg>
{% endmacro %}

