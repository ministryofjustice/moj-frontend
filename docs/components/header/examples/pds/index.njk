{% set navigationHtml %}
    <nav aria-labelledby="probation-common-navigation-heading">
      <h2 id="probation-common-navigation-heading" class="govuk-visually-hidden">
        Navigation menu
      </h2>
      <div class="govuk-width-container probation-common-header__button-width-container">
        <div class="probation-common-header__button-container">
          <div class="probation-common-header__navigation">

            {# USER MENU #}
            <div class="probation-common-header__navigation__item">
              <button class="probation-common-header__menu-toggle probation-common-header__user-menu-toggle" aria-controls="probation-common-header-user-menu" aria-expanded="false" type="button" hidden='hidden'>
                <span>
                  {{ userSvg | safe }}
                  <span>
                    <span class="probation-common-header__menu-toggle-label">Account</span>
                    <span data-qa="probation-common-header-user-name" class="probation-common-header__menu-toggle-label">{{ params.name }}</span>
                  </span>
                </span>
              </button>
              <ul id="probation-common-header-user-menu" class="govuk-list probation-common-header__user-menu" hidden="hidden">
                <li>
                  <a class="probation-common-header__submenu-link" href="{{ params.manageDetailsLink }}">Your account</a>
                </li>
                <li>
                  <a class="probation-common-header__submenu-link" href="/sign-out">Sign out</a>
                </li>
              </ul>

              <div class="probation-common-header__icon-link-wrapper probation-common-header__user-menu-link">
                <a class="probation-common-header__link" href="{{ params.manageDetailsLink }}">
                  <span>
                    <span class="govuk-visually-hidden"> Manage your account or sign out</span>
                    <span>{{ params.name }}</span>
                  </span>
                </a>
              </div>
            </div>
            {# END USER MENU #}

            {# SERVICES MENU #}
            <div class="probation-common-header__navigation__item">
              <button data-qa="probation-common-header__menu-toggle" class="probation-common-header__menu-toggle probation-common-header__services-menu-toggle" aria-controls="probation-common-header-services-menu" aria-expanded="false" data-text-for-show="Show services menu" data-text-for-hide="Hide services menu" type="button" hidden='hidden'>
                  <span>
                    <span class='govuk-!-font-size-19 govuk-!-font-weight-bold'>Menu</span>
                  </span>
              </button>

              <div class="probation-common-header__icon-link-wrapper probation-common-header__services-menu-link">
                <a class="probation-common-header__link" href="{{ params.servicesLink }}">
                    <span>
                      <span class="govuk-visually-hidden"> Services</span>
                      <span>Menu</span>
                    </span>
                </a>
              </div>
            </div>
            {# END SERVICES MENU #}

          </div>
        </div>
      </div>
      {#  END MENU #}
      {# SERVICES MENU #}
      <div id="probation-common-header-services-menu" class="probation-common-header__pushdown-menu probation-common-header__services-menu" hidden="hidden">
        <div class="govuk-width-container">
          <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
              <h3 class="govuk-heading-m">
                Services
              </h3>
              <ul class='govuk-list'>
                {% for service in params.services %}
                  <li><a href='{{ service.href }}' class='probation-common-header__submenu-link' target="{{ service.target | default('_self') }}" {% if service.target == '_blank' %}rel="noopener noreferrer"{% endif %}>{{ service.heading }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </div>
      </div>
      {#  END SERVICES MENU #}
    </nav>
{% endset %}

{{ mojHeader({
  classes: "probation-common-header",
  attributes: {
    "data-module": "pds-header"
  },
  organisationLabel: {
    text: "Probation Digital Services",
    href: "#"
  },
  slots: {
    afterOrganisationLabel: environmentTagHtml,
    end: navigationHtml
  }

}) }}
