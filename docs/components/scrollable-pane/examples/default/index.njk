      },
      {
        text: "Date opened"
      },
      {
        text: "Current status"
      },
      {
        text: "Action"
      },
    ],
    rows:
          {text: "Orchard house" , text: "South West England" , text: "Jan 2009" , text: "Online" , text: "Manage"}
      ,
          {text: "Adam house" , text: "Greater London" , text: "March 2015" , text: "Offline" , text: "Manage"}
      ,
          {text: "Swansea lodge" , text: "South Wales" , text: "Sept 2022" , text: "Online" , text: "Manage"}
      ,
  }) }}
</div>
