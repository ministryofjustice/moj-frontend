{% from "govuk/macros/attributes.njk" import govukAttributes %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "./_mojLogo.njk" import mojLogo %}

{% set classNames = "moj-header " %}
{% set containerClassNames = "moj-header__container " %}
{% set hasAccount = (params.account.username or params.account.signOutLink) %}
{% set hasNavigation = params.navigation.items | length %}

{%- if params.classes %}
  {% set classNames = classNames + " " + params.classes %}
{% endif %}
{% if hasAccount %}
  {% set classNames = classNames + " moj-header--with-account" %}
{% elseif hasNavigation %}
  {% set classNames = classNames + " moj-header--with-navigation" %}
{% endif %}
{%- if params.containerClasses %}
  {% set containerClassNames = containerClassNames + " " + params.containerClasses %}
{% endif %}

{% macro _organisationLabel(params) %}
    {% if params.href -%}
      <a class="moj-header__organisation-name moj-header__link" {% if params.href %} href="{{ params.href | default("/") }}" {% endif %}>
        {{- params.html | safe if params.html else params.text -}}
      </a>
    {% else -%}
      <span class="moj-header__organisation-name">
        {{- params.html | safe if params.html else params.text -}}
      </span>
    {% endif -%}
{% endmacro %}

{% macro _serviceLabel(params) %}
    {% if params.href -%}
      <a class="moj-header__service-name moj-header__link" {% if params.href %} href="{{ params.href | default("/") }}" {% endif %}>
        {{- params.html | safe if params.html else params.text -}}
      </a>
    {% else -%}
      <span class="moj-header__service-name">
        {{- params.html | safe if params.html else params.text -}}
      </span>
    {% endif -%}
{% endmacro %}

{% macro _account(params) %}
  <div class="moj-header__content js-moj-header__wrap-item">
    <nav class="moj-header__account {% if params.classes %} {{ params.classes }}{% endif %}" {% if (params.label) %} aria-label="{{ params.label | default('Account navigation') }}" {% endif %} {{ govukAttributes(params.attributes) }}>
      <span class="moj-header__user">{{ params.username }}</span>
      <ul class="moj-header__list moj-header__list--account">
        {% if params.username and params.manageLink.href %}
          <li class="moj-header__list-item">
              <a class="moj-header__link " href="{{ params.manageLink.href }}">
                {{- params.manageLink.html | safe if params.manageLink.html else params.manageLink.text | default('Manage your details') -}}
                </a>
          </li>
        {% endif %}
        {% if params.signOutLink.href %}
            <li class="moj-header__list-item">
              <a class="moj-header__link" href="{{ params.signOutLink.href }}">
                {{- params.signOutLink.html | safe if params.signOutLink.html else params.signOutLink.text | default('Sign out') -}}
              </a>
            </li>
        {% endif %}
        </ul>
    </nav>
  </div>
{% endmacro %}

{% macro _navigation(params) %}
  <div class="moj-header__content js-moj-header__wrap-item">
    <nav class="moj-header__navigation {% if params.classes %} {{ params.classes }}{% endif %}" {% if (params.label) %} aria-label="{{ params.label | default('Navigation') }}" {% endif %} {{ govukAttributes(params.attributes) }}>
      <ul class="moj-header__list moj-header__list--navigation">
        {%- for item in params.items %}
          <li class="moj-header__list-item">
           {% if item.href %}
              <a class="moj-header__link" href="{{ item.href }}" {{ 'aria-current="page"' | safe if item.active }} {{ govukAttributes(item.attributes) }}>
                {{- item.html | safe if item.html else item.text -}}
              </a>
            {% else %}
              <span class="">
                {{- item.html | safe if item.html else item.text -}}
              </span>
            {% endif %}
          </li>
        {% endfor -%}
      </ul>
    </nav>
  </div>
{% endmacro %}

<header class="moj-header {{ classNames }}" role="banner" {{ govukAttributes(params.attributes) }} data-module="moj-header">
  <div class="moj-header__container {{ containerClassNames }}">
    <div class="moj-header__identity js-moj-header__wrap-reference">
      {{ mojLogo({ type: params.logoType, classes: "moj-header__logo"}) }}
      {{ _organisationLabel(params.organisationLabel) if (params.organisationLabel) }}
      {{ _serviceLabel(params.serviceLabel) if (params.serviceLabel) }}
      {% if params.tag %}
        {{ govukTag(params.tag) }}
      {% endif %}
    </div>

    {% if params.slots.end %}
      {{ params.slots.end | safe }}
    {% elseif hasAccount %}
      {{ _account(params.account) }}
    {% elseif hasNavigation %}
      {{ _navigation(params.navigation) }}
    {% endif %}
  </div>
</header>
