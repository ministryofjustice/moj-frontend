<header class="moj-header {{ classNames }}" role="banner" {{ govukAttributes(params.attributes) }}>
<div class="moj-header__container {{ containerClassNames }}">
  <div class="moj-header__brand">
    <div class="moj-header__logo">
      {{ logoSVG | safe }}
      {%- if (params.organisationLabel) %}
        {% set organisationLabelElement = "span" %}
        {%- if (params.organisationLabel.href) %}
          {% set organisationLabelElement = "a" %}
        {% endif -%}

        <{{organisationLabelElement}} class="moj-header__link moj-header__link--organisation-name" {% if params.organisationLabel.href %} href="{{ params.organisationLabel.href | default("/") }}" {% endif %}>
          {{- params.organisationLabel.html | safe if params.organisationLabel.html else params.organisationLabel.text -}}
        </{{organisationLabelElement}}>
      {% endif -%}
    </div>
    <div class="moj-header__service-name">
      {%- if (params.serviceLabel) %}
        {% set serviceLabelElement = "span" %}
        {%- if (params.serviceLabel.href) %}
          {% set serviceLabelElement = "a" %}
        {% endif -%}

        <{{serviceLabelElement}} class="moj-header__link moj-header__link--service-name" {% if params.serviceLabel.href %} href="{{ params.serviceLabel.href | default("/") }}" {% endif %}>
          {{- params.serviceLabel.html | safe if params.serviceLabel.html else params.serviceLabel.text -}}
        </{{serviceLabelElement}}>
      {% endif -%}
      </span>
      {% if params.tag %}
        {{ govukTag(params.tag) }}
      {% endif %}
    </div>
  </div>

    {% if (params.account.user or params.account.signOutLink) %}
      <div class="moj-header__content">
        <nav class="moj-header__account {% if params.account.classes %} {{ params.account.classes }}{% endif %}" {% if (params.account.label) %} aria-label="{{ params.account.label }}" {% endif %} {{ govukAttributes(params.account.attributes) }}>
        {{ params.account.user.text }}
        <ul class="moj-header__account-list">
          {% if params.account.user and params.account.manageLink.href %}
            <li class="moj-header__account-item">
                <a class="moj-header__account-link " href="{{ params.account.manageLink.href }}">
                  {{- params.account.manageLink.html | safe if params.account.mangeLink.html else params.account.manageLink.text | default('Manage your details') -}}
                  </a>
            </li>
          {% endif %}
          {% if params.account.signOutLink.href %}
              <li class="moj-header__account-item">
                <a class="moj-header__account-link" href="{{ params.account.signOutLink.href }}">
                  {{- params.account.signOutLink.html | safe if params.account.signOutLink.html else params.account.signOutLink.text | default('Sign out') -}}
                </a>
              </li>
          {% endif %}
          </ul>
        </nav>
      </div>
    {% endif %}

    {%- if params.navigation %}
      <div class="moj-header__content">
        <nav class="moj-header__navigation{% if params.navigation.classes %} {{ params.navigation.classes }}{% endif %}"{% if (params.navigation.label) %} aria-label="{{ params.navigation.label }}" {% endif %} {%- for attribute, value in params.navigation.attributes %} {{ attribute }}="{{ value }}"{% endfor %}>
          <ul class="moj-header__navigation-list">
            {%- for item in params.navigation.items %}
            <li class="moj-header__navigation-item">
             {% if item.href %}
                <a class="moj-header__navigation-link" href="{{ item.href }}" {{ 'aria-current="page"' | safe if item.active }} {%- for attribute, value in item.attributes %} {{ attribute }}="{{ value }}"{% endfor %}>
                  {{- item.html | safe if item.html else item.text -}}
                  </a>
              {% else %}
                <span class="">
                  {{- item.html | safe if item.html else item.text -}}
                </span>
              {% endif %}
              </li>
            {% endfor -%}
          </ul>
        </nav>
      </div>
    {% endif -%}


    {% if params.slots.end %}
      {{ params.slots.end | safe }}
    {% endif %}

    </div>

</header>
